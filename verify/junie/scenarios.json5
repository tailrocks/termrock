// Scenario table for the junie-tui -> termrock fidelity harness.
//
// One entry per comparison. The reference side names an artifact that
// bin/ref_capture.sh regenerates into reference/scenes/<scene>.{txt,ansi}; the
// termrock side names a termrock-lookbook story rendered with
// `cargo run -p termrock-lookbook -- frame --story <id>`.
//
//   status: "pending-termrock-scene"   no termrock story maps to this page yet.
//                                      run.py reports SKIP and does not gate.
//   status omitted                     active: compared on the text and color cell
//                                      layers (bin/run.py explains the budget rules).
//
// Coordinates are cells. reference.crop is [x, y, w, h] inside the captured page.
// termrock.cols/rows are the inner story size (widget anatomy). termrock.crop
// strips the one-cell lookbook pad so both sides show the same widget cells.
//
// The 40 showcase entries are exactly the reference's own FNV baseline matrix
// (20 NAV pages x 120x40 and 80x24), so this gate and that one are mutually
// checkable. tablepro has no --page flag: its screens are reached with
// --connect/--keys, and only the ones that survive a clean tmux capture are listed.
{
  scenarios: [
  {
    scene: "showcase_overview_120x40",
    reference: { bin: "showcase", args: ["--page", "Overview"], cols: 120, rows: 40,
                  crop: [28, 4, 42, 21] },
    termrock: { story: "overview/tokens", cols: 42, rows: 21, crop: [1, 1, 42, 21] },
    tolerance: { text_cells: 0, color_cells: 0 },
    note: "Overview Tokens card: swatch ▏ name and note, 19 tokens",
  },
  {
    scene: "showcase_buttons_120x40",
    reference: { bin: "showcase", args: ["--page", "Buttons"], cols: 120, rows: 40,
                  crop: [28, 7, 48, 1] },
    termrock: { story: "button-group/actions", cols: 48, rows: 1, crop: [1, 1, 48, 1] },
    tolerance: { text_cells: 0, color_cells: 0 },
    note: "junie Actions row: Run task / Preview / Cancel / Delete branch.",
  },
  {
