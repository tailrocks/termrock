{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**",
    "**/.config/mise/locks/**",
    ".github/workflows/**",
    ".github/actions/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^rust-toolchain\\.toml$/"
      ],
      "matchStrings": [
        "channel = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "soft = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "rust",
        "rust-lang/rust"
      ],
      "groupName": "rust toolchain"
    },
    {
      "description": "Cap the Rust toolchain below 1.100.0. velnor-actions, which generates CI, is end-of-life: v0.1.81 is its last release, and it qualifies Rust only up to 1.99.1 (tailrocks/velnor-new#1625 is closed as obsolete). CI fails on 1.100.0, so Renovate must not propose it (PR #484). Lift this cap only after CI moves to velnor-gen and that generator qualifies a newer Rust.",
      "matchDepNames": [
        "rust",
        "rust-lang/rust"
      ],
      "allowedVersions": "<1.100.0"
    },
    {
      "description": "These mise tools publish v-prefixed release tags that Renovate would otherwise write verbatim; the velnor resolver needs bare X.Y.Z, so strip the prefix and ignore tags that are not plain X.Y.Z.",
      "matchDepNames": [
        "jactionlint",
        "mr-boxington",
        "github:tailrocks/velnor-new"
      ],
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "matchDepNames": [
        "github:tailrocks/velnor-new"
      ],
      "dependencyDashboardApproval": true,
      "addLabels": [
        "needs-regenerate"
      ]
    }
  ],
  "prHourlyLimit": 4,
  "prConcurrentLimit": 4,
  "branchConcurrentLimit": 4,
  "commitBody": "Signed-off-by: Renovate Bot <renovate@whitesourcesoftware.com>",
  "rebaseWhen": "conflicted",
  "pin": {
    "rebaseWhen": "conflicted"
  },
  "recreateWhen": "always",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  }
}
