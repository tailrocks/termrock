{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termrock.dev/schemas/component-contract.schema.json",
  "title": "TermRock catalog quality contracts",
  "description": "Complete evidence ledger for every canonical component and pattern documentation entry.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 2
    },
    "version": {
      "$ref": "#/$defs/nonBlankString"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "covered",
        "partial",
        "caller_owned",
        "not_applicable",
        "missing"
      ]
    },
    "applicability": {
      "type": "string",
      "enum": [
        "required",
        "conditional"
      ]
    },
    "lintStatus": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "waived",
        "not_run"
      ]
    },
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "stories",
        "tests",
        "recordings",
        "benches"
      ],
      "additionalProperties": false,
      "properties": {
        "stories": {
          "$ref": "#/$defs/stringList"
        },
        "tests": {
          "$ref": "#/$defs/stringList"
        },
        "recordings": {
          "$ref": "#/$defs/stringList"
        },
        "benches": {
          "$ref": "#/$defs/stringList"
        },
        "posters": {
          "$ref": "#/$defs/stringList"
        },
        "sources": {
          "$ref": "#/$defs/stringList"
        },
        "checks": {
          "$ref": "#/$defs/stringList"
        },
        "notes": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticket": {
          "$ref": "#/$defs/nonBlankString"
        },
        "expires": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "axis": {
      "type": "object",
      "required": [
        "applicability",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/applicability"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "reason": {
          "$ref": "#/$defs/nonBlankString"
        },
        "waiver": {
          "$ref": "#/$defs/waiver"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "caller_owned",
                  "not_applicable",
                  "missing"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "covered",
                  "partial"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "anyOf": [
                  {
                    "properties": {
                      "stories": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "tests": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "recordings": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "benches": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "posters": {
                        "minItems": 1
                      }
                    }
                  },
                  {
                    "properties": {
                      "checks": {
                        "minItems": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "completeAxis": {
      "allOf": [
        {
          "$ref": "#/$defs/axis"
        },
        {
          "properties": {
            "status": {
              "enum": [
                "covered",
                "partial",
                "caller_owned",
                "not_applicable"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "required"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "covered",
                  "partial"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            }
          },
          "then": {
            "required": [
              "waiver"
            ],
            "properties": {
              "waiver": {
                "required": [
                  "ticket"
                ]
              }
            }
          }
        }
      ]
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_states",
        "keyboard",
        "mouse",
        "focus",
        "disabled",
        "loading",
        "error",
        "empty",
        "overlay",
        "escape",
        "responsive",
        "tiny_terminal",
        "unicode",
        "cjk",
        "combining",
        "emoji",
        "ascii_fallback",
        "no_color",
        "color_ladder",
        "streaming",
        "large_data",
        "resize",
        "panic_safety"
      ],
      "properties": {
        "visual_states": {
          "$ref": "#/$defs/axis"
        },
        "keyboard": {
          "$ref": "#/$defs/axis"
        },
        "mouse": {
          "$ref": "#/$defs/axis"
        },
        "focus": {
          "$ref": "#/$defs/axis"
        },
        "disabled": {
          "$ref": "#/$defs/axis"
        },
        "loading": {
          "$ref": "#/$defs/axis"
        },
        "error": {
          "$ref": "#/$defs/axis"
        },
        "empty": {
          "$ref": "#/$defs/axis"
        },
        "overlay": {
          "$ref": "#/$defs/axis"
        },
        "escape": {
          "$ref": "#/$defs/axis"
        },
        "responsive": {
          "$ref": "#/$defs/axis"
        },
        "tiny_terminal": {
          "$ref": "#/$defs/axis"
        },
        "unicode": {
          "$ref": "#/$defs/axis"
        },
        "cjk": {
          "$ref": "#/$defs/axis"
        },
        "combining": {
          "$ref": "#/$defs/axis"
        },
        "emoji": {
          "$ref": "#/$defs/axis"
        },
        "ascii_fallback": {
          "$ref": "#/$defs/axis"
        },
        "no_color": {
          "$ref": "#/$defs/axis"
        },
        "color_ladder": {
          "$ref": "#/$defs/axis"
        },
        "streaming": {
          "$ref": "#/$defs/axis"
        },
        "large_data": {
          "$ref": "#/$defs/axis"
        },
        "resize": {
          "$ref": "#/$defs/axis"
        },
        "panic_safety": {
          "$ref": "#/$defs/axis"
        }
      }
    },
    "completeAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_states",
        "keyboard",
        "mouse",
        "focus",
        "disabled",
        "loading",
        "error",
        "empty",
        "overlay",
        "escape",
        "responsive",
        "tiny_terminal",
        "unicode",
        "cjk",
        "combining",
        "emoji",
        "ascii_fallback",
        "no_color",
        "color_ladder",
        "streaming",
        "large_data",
        "resize",
        "panic_safety"
      ],
      "properties": {
        "visual_states": {
          "$ref": "#/$defs/completeAxis"
        },
        "keyboard": {
          "$ref": "#/$defs/completeAxis"
        },
        "mouse": {
          "$ref": "#/$defs/completeAxis"
        },
        "focus": {
          "$ref": "#/$defs/completeAxis"
        },
        "disabled": {
          "$ref": "#/$defs/completeAxis"
        },
        "loading": {
          "$ref": "#/$defs/completeAxis"
        },
        "error": {
          "$ref": "#/$defs/completeAxis"
        },
        "empty": {
          "$ref": "#/$defs/completeAxis"
        },
        "overlay": {
          "$ref": "#/$defs/completeAxis"
        },
        "escape": {
          "$ref": "#/$defs/completeAxis"
        },
        "responsive": {
          "$ref": "#/$defs/completeAxis"
        },
        "tiny_terminal": {
          "$ref": "#/$defs/completeAxis"
        },
        "unicode": {
          "$ref": "#/$defs/completeAxis"
        },
        "cjk": {
          "$ref": "#/$defs/completeAxis"
        },
        "combining": {
          "$ref": "#/$defs/completeAxis"
        },
        "emoji": {
          "$ref": "#/$defs/completeAxis"
        },
        "ascii_fallback": {
          "$ref": "#/$defs/completeAxis"
        },
        "no_color": {
          "$ref": "#/$defs/completeAxis"
        },
        "color_ladder": {
          "$ref": "#/$defs/completeAxis"
        },
        "streaming": {
          "$ref": "#/$defs/completeAxis"
        },
        "large_data": {
          "$ref": "#/$defs/completeAxis"
        },
        "resize": {
          "$ref": "#/$defs/completeAxis"
        },
        "panic_safety": {
          "$ref": "#/$defs/completeAxis"
        }
      }
    },
    "lints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color_only_state",
        "invisible_keyboard_focus",
        "primary_clipped_before_secondary",
        "interactive_without_semantic_role",
        "mouse_without_keyboard",
        "unpredictable_overlay_dismiss",
        "hardcoded_key_handling",
        "missing_ascii_fallback",
        "focus_selection_indistinguishable",
        "idle_animation_redraw",
        "zero_area_panic",
        "missing_contract_evidence",
        "stale_contract_component"
      ],
      "properties": {
        "color_only_state": {
          "$ref": "#/$defs/lintStatus"
        },
        "invisible_keyboard_focus": {
          "$ref": "#/$defs/lintStatus"
        },
        "primary_clipped_before_secondary": {
          "$ref": "#/$defs/lintStatus"
        },
        "interactive_without_semantic_role": {
          "$ref": "#/$defs/lintStatus"
        },
        "mouse_without_keyboard": {
          "$ref": "#/$defs/lintStatus"
        },
        "unpredictable_overlay_dismiss": {
          "$ref": "#/$defs/lintStatus"
        },
        "hardcoded_key_handling": {
          "$ref": "#/$defs/lintStatus"
        },
        "missing_ascii_fallback": {
          "$ref": "#/$defs/lintStatus"
        },
        "focus_selection_indistinguishable": {
          "$ref": "#/$defs/lintStatus"
        },
        "idle_animation_redraw": {
          "$ref": "#/$defs/lintStatus"
        },
        "zero_area_panic": {
          "$ref": "#/$defs/lintStatus"
        },
        "missing_contract_evidence": {
          "$ref": "#/$defs/lintStatus"
        },
        "stale_contract_component": {
          "$ref": "#/$defs/lintStatus"
        }
      }
    },
    "completeLints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color_only_state",
        "invisible_keyboard_focus",
        "primary_clipped_before_secondary",
        "interactive_without_semantic_role",
        "mouse_without_keyboard",
        "unpredictable_overlay_dismiss",
        "hardcoded_key_handling",
        "missing_ascii_fallback",
        "focus_selection_indistinguishable",
        "idle_animation_redraw",
        "zero_area_panic",
        "missing_contract_evidence",
        "stale_contract_component"
      ],
      "properties": {
        "color_only_state": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "invisible_keyboard_focus": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "primary_clipped_before_secondary": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "interactive_without_semantic_role": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "mouse_without_keyboard": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "unpredictable_overlay_dismiss": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "hardcoded_key_handling": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "missing_ascii_fallback": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "focus_selection_indistinguishable": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "idle_animation_redraw": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "zero_area_panic": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "missing_contract_evidence": {
          "enum": [
            "pass",
            "waived"
          ]
        },
        "stale_contract_component": {
          "enum": [
            "pass",
            "waived"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "entryKind",
        "complete",
        "axes",
        "lints"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 2
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9_]*$"
        },
        "entryKind": {
          "type": "string",
          "enum": [
            "component",
            "pattern"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "axes": {
          "$ref": "#/$defs/axes"
        },
        "lints": {
          "$ref": "#/$defs/lints"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "axes": {
                "$ref": "#/$defs/completeAxes"
              },
              "lints": {
                "$ref": "#/$defs/completeLints"
              }
            }
          }
        }
      ]
    }
  }
}
